    { "id": "reservation-entry", "description": "予約システム見出しの右側action群に既存secondary button語彙のAPIキー管理リンクを置き、デモ予約生成buttonを維持する" },
    { "id": "api-key-reference", "description": "公開APIの5権限をLIST・READ・CREATE・UPDATE・DELETEと対応するHTTP method・versioned endpoint・操作説明で一覧表示する" },
    { "id": "api-key-table", "description": "発行済みキーは名前、masked識別子、権限chip、発行日時、最終利用、状態、無効化操作を既存table密度で表示し、raw secretは含めない" },
    { "id": "usage-limit-summary", "description": "全予約APIキーで共有する月間上限、今月の利用、残り、Asia/Tokyoの次回リセットを表示し、上限なしでも利用件数を表示する" },
    { "id": "usage-limit-dialog", "description": "上限変更dialogは100件以上の整数、10,000件超は100件単位、上限なしをnative radioとtext inputで選べ、背景inert、focus trap、Escape、focus returnを備える" },
    { "id": "permission-dialog", "description": "発行dialogはAPIキー名と独立した5権限のnative checkboxを持ち、少なくとも1権限を要求し、背景をinert化してfocusをdialog内へ閉じ込める" },
    { "id": "one-time-secret", "description": "発行成功dialogはraw APIキーを一度だけreadonly入力で表示し、copy操作と再表示不可の警告を明示する" },
    { "id": "revoke-dialog", "description": "無効化dialogは対象名、即時失効、取消不能を明示し、cancelを初期focusにしてdanger actionを分離する" },
    { "id": "restricted-states", "description": "VIEW-onlyでは発行・無効化・上限変更をdisabledにして理由を表示し、0件ではtableの代わりに専用empty stateを表示する" },
    { "id": "responsive-overflow", "description": "390pxではactionを自然に折り返し、API referenceとkey tableだけをカード内横scrollに限定し、dialogはviewport内で縦scrollしdocument横overflowを発生させない" }
