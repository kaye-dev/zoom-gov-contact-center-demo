  "visualInvariants": [
    {
      "id": "admin-shell",
      "description": "未来市、市名横の管理画面label、ユーザー管理と設定dropdown、ログアウト、sticky header、max-w-7xl、余白、境界線、矢印SVGを既存AdminShellと一致させる"
    },
    {
      "id": "reservation-navigation",
      "description": "予約システムをsettingsではなく主要業務の直接linkとしてsettingsとログアウトの間に置き、VIEW権限がある場合だけ表示してcurrent pageをtext-accentで示す"
    },
    {
      "id": "reservation-toolbar",
      "description": "見出し、説明、業務select、月移動、今月、デモ予約生成を既存button・select・cardの密度、focus、disabled、pointer規約で構成する"
    },
    {
      "id": "calendar-grid",
      "description": "日曜始まりの7列月間calendarに日付、受付状態、日単位または時間枠の集計を表示し、受付外と過去日はdisabled、選択日はsemantic selected surfaceとaria-pressedで示す"
    },
    {
      "id": "selected-date-panel",
      "description": "選択した日付、業務名、日付予約の1日枠または日時予約の時間・施設枠、予約数、定員、残数を同じ詳細panelで表示する"
    },
    {
      "id": "availability-status",
      "description": "空きあり、残りわずか、満員、受付なしを文字とgreen/amber/redの既存theme対応色で併記し、色だけに依存しない"
    },
    {
      "id": "responsive-flow",
      "description": "1280pxと1024px以上ではcalendarと詳細を2列、1023px以下では縦積みにし、390pxを含む全viewportで7列calendar、header、controlsに横overflowやclippingを発生させない"
    },
    {
      "id": "permission-state",
      "description": "VIEW-onlyではcalendar閲覧と業務・月切替を維持し、デモ予約生成buttonをdisabledにして理由をstatusとして表示する"
    },
    {
      "id": "random-generation",
      "description": "表示月の4業務を一度に再生成し、pending中はbuttonをdisabledかつaria-busyにし、完了後は成功statusと更新済みのcalendar・詳細を表示してfocusをbuttonに保持する"
    }
  ],
  "intentionalDifferences": [
    {
      "id": "prototype-static-route",
      "description": "productionの予約システムlinkは /admin/reservations、静的prototypeは実在する ./index.html を使用する"
    },
    {
      "id": "prototype-mocked-generation",
      "description": "prototypeのデモ予約生成はlocal JavaScriptの合成件数だけを変更し、production API、DB、個人情報へ接続しない"
    }
  ],
