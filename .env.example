# Local deployment profile selector. Never sent to Vercel or the app runtime.
DEPLOY_AWS_PROFILE=

# These are Local checkout defaults. ./dev-compose.sh generates checkout-specific
# ports and origins in .codex/runtime.local.env for Codex worktrees.
HOST_PORT=3000
POSTGRES_PORT=5432
STUDIO_PORT=5555

# Primary/read-write PostgreSQL endpoint. Do not use a read replica.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zoom_demo"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Development only. Use a separately generated 32-byte base64 key outside local development.
DEVELOPER_API_SETTINGS_ENCRYPTION_KEY="bG9jYWwtZGV2ZWxvcG1lbnQta2V5LTEyMzQ1Njc4OTA="
APP_CANONICAL_ORIGIN="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD="ChangeMe12345!"
SEED_ADMIN_NAME="Demo Admin"
