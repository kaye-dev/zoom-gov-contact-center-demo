# Local deployment profile selector. Never sent to Vercel or the app runtime.
DEPLOY_AWS_PROFILE=

# These are Local checkout defaults. ./dev-compose.sh generates checkout-specific
# ports and origins in .codex/runtime.local.env for Codex worktrees.
HOST_PORT=3000
POSTGRES_PORT=5432
STUDIO_PORT=5555

# Primary/read-write PostgreSQL endpoint. Do not use a read replica.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zoom_demo"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Development only. Use a separately generated 32-byte base64 key outside local development.
DEVELOPER_API_SETTINGS_ENCRYPTION_KEY="bG9jYWwtZGV2ZWxvcG1lbnQta2V5LTEyMzQ1Njc4OTA="
APP_CANONICAL_ORIGIN="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD="ChangeMe12345!"
SEED_ADMIN_NAME="Demo Admin"

# Explicit opt-in gates for destructive Zoom Contact Center contract tests.
# Normal application and test commands must keep these disabled. Credentials are read
# from the encrypted local Developer API settings row and are never duplicated here.
ZAAD_ZOOM_LIVE_CONTRACT_TEST=0
# Confirm each mutation family independently after its tenant contract succeeds.
# Enabling one family never enables another family implicitly.
ZAAD_ZOOM_CONTACT_WRITE_CONTRACT_CONFIRMED=0
ZAAD_ZOOM_TTS_WRITE_CONTRACT_CONFIRMED=0
ZAAD_ZOOM_CAMPAIGN_WRITE_CONTRACT_CONFIRMED=0
ZAAD_ZOOM_LIVE_NON_PRODUCTION_ACK=0
ZAAD_ZOOM_LIVE_TENANT_CLASS=
# Set exactly to I_UNDERSTAND_THIS_CREATES_AND_DELETES_ZOOM_RESOURCES at action time.
ZAAD_ZOOM_LIVE_CONTRACT_ACK=
# Must match the configured Server-to-Server OAuth account exactly.
ZAAD_ZOOM_LIVE_ACCOUNT_ID=
# Must match ZAAD-LIVE-CONTRACT-[A-Za-z0-9-]{1,28}; a random suffix is added per run.
ZAAD_ZOOM_LIVE_RESOURCE_PREFIX=ZAAD-LIVE-CONTRACT-LOCAL

# Required only by test:zaad:zoom-contract:campaign. Set this to an exact synthetic,
# non-running Agentless flow campaign created in the Zoom web portal. The contract
# derives and validates its queue, flow, and caller before empty-recipient Draft CRUD.
ZAAD_ZOOM_LIVE_BASE_CAMPAIGN_ID=
