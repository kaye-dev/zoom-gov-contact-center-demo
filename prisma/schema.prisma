generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PasswordResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONSUMED
}

enum SiteLocale {
  JA
  EN
  ZH_HANS
  ZH_HANT
  KO
}

enum ZoomChatMode {
  DISABLED
  CAMPAIGN
  CONTACT_CENTER_ENTRY_ID
}

enum MaintenanceEnvironment {
  PRODUCTION
  PREVIEW
  DEVELOPMENT
}

enum MaintenanceMode {
  DISABLED
  ENABLED
  SCHEDULED
}

enum AdminAccessAction {
  VIEW
  CREATE
  UPDATE
  DELETE
}

enum AdminAccessEffect {
  ALLOW
  DENY
}

enum AdminAccessSystemRole {
  FULL_ACCESS
  NO_ACCESS
}

enum ReservationApiPermission {
  LIST
  READ
  CREATE
  UPDATE
  DELETE
}

enum DisasterRadioConsentStatus {
  CONSENTED
  NOT_CONSENTED
}

enum DisasterRadioRegistrationSource {
  PUBLIC_FORM
  ADMIN_FORM
  ADMIN_CSV
}

enum ZoomContactSyncStatus {
  NOT_ELIGIBLE
  NOT_ASSIGNED
  PENDING
  SYNCED
  FAILED
}

enum ZaadMessageSyncStatus {
  PENDING
  SYNCED
  SYNC_FAILED
}

enum ZaadOneTimeDispatchState {
  DRAFT
  PREPARING
  READY
  FAILED
  RESULT_UNKNOWN
}

model user {
  id                        String    @id
  name                      String
  email                     String
  emailVerified             Boolean
  image                     String?
  createdAt                 DateTime
  updatedAt                 DateTime
  role                      String?
  banned                    Boolean?
  banReason                 String?
  banExpires                DateTime?
  mustChangePassword        Boolean   @default(false)
  temporaryPasswordIssuedAt DateTime?
  passwordChangedAt         DateTime?
  adminAccessRoleRevision   Int       @default(1)

  sessions                           session[]
  accounts                           account[]
  passwordResetRequests              PasswordResetRequest[]       @relation("PasswordResetRequestUser")
  reviewedPasswordRequests           PasswordResetRequest[]       @relation("PasswordResetRequestReviewer")
  accessRoleAssignments              AdminAccessRoleAssignment[]  @relation("AdminAccessRoleAssignmentUser")
  assignedRoleAssignments            AdminAccessRoleAssignment[]  @relation("AdminAccessRoleAssignmentActor")
  createdReservationApiKeys          ReservationApiKey[]          @relation("ReservationApiKeyCreatedBy")
  revokedReservationApiKeys          ReservationApiKey[]          @relation("ReservationApiKeyRevokedBy")
  updatedReservationApiUsageSettings ReservationApiUsageSetting[] @relation("ReservationApiUsageSettingUpdatedBy")
  registeredDisasterRadioResidents   DisasterRadioSubscription[]  @relation("DisasterRadioSubscriptionRegisteredBy")
  updatedZaadRegistrationSettings    ZaadRegistrationSetting[]    @relation("ZaadRegistrationSettingUpdatedBy")
  createdZaadOutboundMessages        ZaadOutboundMessage[]        @relation("ZaadOutboundMessageCreatedBy")
  updatedZaadOutboundMessages        ZaadOutboundMessage[]        @relation("ZaadOutboundMessageUpdatedBy")
  createdZaadOneTimeDispatches       ZaadOneTimeDispatch[]        @relation("ZaadOneTimeDispatchCreatedBy")

  @@unique([email])
  @@map("user")
}

model session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model DemoRecord {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("demo_records")
}

model PasswordResetRequest {
  id               String                     @id @default(cuid())
  email            String
  status           PasswordResetRequestStatus @default(PENDING)
  requestedAt      DateTime                   @default(now())
  reviewedAt       DateTime?
  issuedAt         DateTime?
  consumedAt       DateTime?
  userId           String?
  reviewedByUserId String?

  user       user? @relation("PasswordResetRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy user? @relation("PasswordResetRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, requestedAt])
  @@map("password_reset_requests")
}

model SitePhoneSetting {
  id                         Int      @id @default(1)
  representativePhoneDisplay String
  representativePhoneE164    String
  updatedAt                  DateTime @default(now()) @updatedAt

  @@map("site_phone_settings")
}

model LocalizedAiPhoneSetting {
  locale      SiteLocale @id
  aiPhoneE164 String?
  updatedAt   DateTime   @default(now()) @updatedAt

  @@map("localized_ai_phone_settings")
}

model SiteChatSetting {
  id                         Int          @id @default(1)
  activeMode                 ZoomChatMode @default(DISABLED)
  campaignWebTag             String?
  campaignMemo               String?
  contactCenterEntryIdWebTag String?
  contactCenterEntryIdMemo   String?
  updatedAt                  DateTime     @default(now()) @updatedAt

  @@map("site_chat_settings")
}

model LocaleDisplaySetting {
  locale       SiteLocale @id
  enabled      Boolean    @default(true)
  displayOrder Int
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([displayOrder])
  @@map("locale_display_settings")
}

model SiteMaintenanceSetting {
  environment      MaintenanceEnvironment @id
  schemaVersion    Int                    @default(1) @map("version")
  mode             MaintenanceMode        @default(DISABLED)
  scheduledStartAt DateTime?              @db.Timestamptz(3)
  scheduledEndAt   DateTime?              @db.Timestamptz(3)
  revision         Int                    @default(1)
  updatedAt        DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_maintenance_settings")
}

model SiteDeveloperApiSetting {
  id                    Int      @id @default(1)
  accountId             String
  clientId              String
  clientSecretEncrypted String?
  secretTokenEncrypted  String?
  updatedAt             DateTime @default(now()) @updatedAt

  @@map("site_developer_api_settings")
}

model AdminAccessRole {
  id          String                 @id @default(cuid())
  name        String
  nameKey     String                 @unique
  description String?
  systemKey   AdminAccessSystemRole? @unique
  revision    Int                    @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt

  permissions AdminAccessRolePermission[]
  assignments AdminAccessRoleAssignment[]

  @@map("admin_access_roles")
}

model AdminAccessRolePermission {
  roleId      String
  resourceKey String
  action      AdminAccessAction
  effect      AdminAccessEffect

  role AdminAccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, resourceKey, action])
  @@map("admin_access_role_permissions")
}

model AdminAccessRoleAssignment {
  userId           String
  roleId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  user       user            @relation("AdminAccessRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy user?           @relation("AdminAccessRoleAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  role       AdminAccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@unique([userId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("admin_access_role_assignments")
}

model AdminAccessMutationState {
  id        String    @id
  frozen    Boolean   @default(false)
  freezeId  String?
  frozenAt  DateTime?
  reason    String?
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("admin_access_mutation_state")
}

model ReservationBooking {
  id                  String    @id @default(cuid())
  serviceKey          String
  reservationDate     DateTime  @db.Date
  startMinute         Int
  isDemo              Boolean   @default(false)
  apiKeyId            String?
  externalReferenceId String?
  callerAniDigest     String?
  revision            Int?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime? @updatedAt @db.Timestamptz(3)

  @@index([serviceKey, reservationDate, startMinute])
  @@index([reservationDate, isDemo])
  @@map("reservation_bookings")
}

model ReservationApiKey {
  id              String    @id @default(cuid())
  publicId        String    @unique
  name            String
  secretHash      String    @unique
  monthlyLimit    BigInt?
  revision        Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt      DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  createdByUserId String?
  revokedByUserId String?

  createdBy          user?                             @relation("ReservationApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revokedBy          user?                             @relation("ReservationApiKeyRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  permissions        ReservationApiKeyPermission[]
  monthlyUsage       ReservationApiKeyMonthlyUsage[]
  requestLogs        ReservationApiRequestLog[]
  idempotencyRecords ReservationApiIdempotencyRecord[]

  @@index([createdAt, id])
  @@index([revokedAt])
  @@map("reservation_api_keys")
}

model ReservationApiRequestLog {
  id                 String                   @id @default(cuid())
  apiKeyId           String?
  apiKeyName         String
  apiKeyPreview      String
  permission         ReservationApiPermission
  method             String
  path               String
  pathParameters     Json?
  query              Json?
  requestBody        Json?
  responseBody       Json?
  statusCode         Int
  errorCode          String?
  durationMs         Int
  requestedAt        DateTime                 @db.Timestamptz(3)
  completedAt        DateTime                 @db.Timestamptz(3)
  idempotencyOutcome String?
  responseLocation   String?
  responseEtag       String?

  apiKey ReservationApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([requestedAt, id])
  @@index([apiKeyId, requestedAt])
  @@index([method, requestedAt])
  @@index([statusCode, requestedAt])
  @@map("reservation_api_request_logs")
}

model ReservationApiIdempotencyRecord {
  id               String   @id @default(cuid())
  apiKeyId         String
  keyDigest        String
  requestDigest    String
  reservationId    String
  statusCode       Int
  responseBody     Json
  responseLocation String
  responseEtag     String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime @db.Timestamptz(3)

  apiKey ReservationApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, keyDigest])
  @@index([expiresAt])
  @@index([reservationId])
  @@map("reservation_api_idempotency_records")
}

model ReservationApiKeyMonthlyUsage {
  apiKeyId     String
  periodStart  DateTime @db.Date
  requestCount BigInt   @default(0)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  apiKey ReservationApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, periodStart])
  @@index([periodStart])
  @@map("reservation_api_key_monthly_usage")
}

model ReservationApiKeyPermission {
  apiKeyId   String
  permission ReservationApiPermission

  apiKey ReservationApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, permission])
  @@map("reservation_api_key_permissions")
}

model ReservationApiUsageSetting {
  id              Int      @id @default(1)
  monthlyLimit    BigInt?
  revision        Int      @default(1)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedByUserId String?

  updatedBy user? @relation("ReservationApiUsageSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("reservation_api_usage_settings")
}

model ReservationApiMonthlyUsage {
  periodStart  DateTime @id @db.Date
  requestCount BigInt   @default(0)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("reservation_api_monthly_usage")
}

model DisasterRadioSubscription {
  id                          String                          @id @default(cuid())
  name                        String
  normalizedEmail             String
  normalizedPhone             String
  consentStatus               DisasterRadioConsentStatus
  consentVersion              String?
  consentedAt                 DateTime?                       @db.Timestamptz(3)
  source                      DisasterRadioRegistrationSource
  registeredByUserId          String?
  revision                    Int                             @default(1)
  zoomContactListId           String?
  zoomContactListNameSnapshot String?
  zoomContactId               String?
  syncStatus                  ZoomContactSyncStatus
  syncErrorCode               String?
  syncedAt                    DateTime?                       @db.Timestamptz(3)
  createdAt                   DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                        @default(now()) @updatedAt @db.Timestamptz(3)

  registeredBy user? @relation("DisasterRadioSubscriptionRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)

  // PostgreSQL truncated the 64-byte migration identifier to this 63-byte name.
  @@unique([normalizedEmail, normalizedPhone], map: "disaster_radio_subscriptions_normalizedEmail_normalizedPhone_ke")
  @@index([createdAt, id])
  @@index([consentStatus, syncStatus])
  @@index([zoomContactListId])
  @@map("disaster_radio_subscriptions")
}

model ZaadRegistrationSetting {
  id                      Int      @id @default(1)
  contactListId           String?
  contactListNameSnapshot String?
  revision                Int      @default(1)
  updatedByUserId         String?
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  updatedBy user? @relation("ZaadRegistrationSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("zaad_registration_settings")
}

model ZaadOutboundMessage {
  id              String                @id @default(cuid())
  name            String
  body            String
  languageCode    String                @default("ja-JP")
  voiceId         String
  zoomAssetId     String?
  zoomAssetItemId String?
  syncStatus      ZaadMessageSyncStatus @default(PENDING)
  syncErrorCode   String?
  syncedAt        DateTime?             @db.Timestamptz(3)
  revision        Int                   @default(1)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  createdBy user? @relation("ZaadOutboundMessageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy user? @relation("ZaadOutboundMessageUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedAt, id])
  @@map("zaad_outbound_messages")
}

model ZaadOneTimeDispatch {
  id                    String                   @id @default(cuid())
  operationKey          String                   @unique
  name                  String
  body                  String
  languageCode          String                   @default("ja-JP")
  voiceId               String
  state                 ZaadOneTimeDispatchState @default(DRAFT)
  baseCampaignId        String
  selectedListCount     Int                      @default(0)
  selectedResidentCount Int                      @default(0)
  duplicateCount        Int                      @default(0)
  recipientCount        Int                      @default(0)
  lastCompletedStep     String?
  zoomContactListId     String?
  zoomAssetId           String?
  zoomAssetItemId       String?
  zoomCampaignId        String?
  stableErrorCode       String?
  revision              Int                      @default(1)
  createdByUserId       String?
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)

  createdBy   user?                           @relation("ZaadOneTimeDispatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sourceLists ZaadOneTimeDispatchSourceList[]
  residents   ZaadOneTimeDispatchResident[]

  @@index([createdAt, id])
  @@index([state, updatedAt])
  @@map("zaad_one_time_dispatches")
}

model ZaadOneTimeDispatchSourceList {
  dispatchId    String
  contactListId String
  selectedOrder Int

  dispatch ZaadOneTimeDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@id([dispatchId, contactListId])
  // PostgreSQL truncated the 64-byte migration identifier to this 63-byte name.
  @@unique([dispatchId, selectedOrder], map: "zaad_one_time_dispatch_source_lists_dispatchId_selectedOrder_ke")
  @@map("zaad_one_time_dispatch_source_lists")
}

model ZaadOneTimeDispatchResident {
  dispatchId       String
  residentId       String
  residentRevision Int
  selectedOrder    Int

  dispatch ZaadOneTimeDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@id([dispatchId, residentId])
  @@unique([dispatchId, selectedOrder])
  @@map("zaad_one_time_dispatch_residents")
}

model ZaadAdminAudit {
  id                 String   @id @default(cuid())
  actorUserId        String?
  resourceKind       String
  targetRef          String
  action             String
  result             String
  changedFieldNames  String[]
  fromConsentStatus  String?
  toConsentStatus    String?
  fromCampaignStatus String?
  toCampaignStatus   String?
  stableErrorCode    String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([actorUserId, createdAt])
  @@index([resourceKind, createdAt])
  @@map("zaad_admin_audits")
}
