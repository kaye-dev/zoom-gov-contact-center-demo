{
  "name": "zoom-gov-contact-center-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "node --import tsx --test test/*.test.ts",
    "aws:test-scripts": "node --import tsx --test scripts/aws/test/*.test.ts",
    "audit:runtime": "npm audit --omit=dev",
    "test:infra": "node --import tsx --test infra/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:infra": "tsc -p infra/tsconfig.json --noEmit",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "faq:generate-translations": "tsx scripts/generate-faq-translations.ts",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:studio:docker": "prisma studio --port 5555 --browser none",
    "db:seed-admin": "tsx prisma/seed-admin.ts",
    "cdk": "cdk",
    "aws:deploy": "./scripts/aws/deploy.sh",
    "aws:warmup": "tsx scripts/aws/warmup.ts",
    "aws:verify-pause": "tsx scripts/aws/verify-pause.ts",
    "aws:seed-admin": "tsx scripts/aws/seed-admin.ts",
    "aws:destroy": "./scripts/aws/destroy.sh"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/mdx": "^2.0.14",
    "aws-ssl-profiles": "1.1.2",
    "better-auth": "1.6.26",
    "dotenv": "^17.4.2",
    "hono": "4.13.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "prisma": "7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk": "2.1135.0",
    "aws-cdk-lib": "2.263.0",
    "constructs": "10.8.1",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
