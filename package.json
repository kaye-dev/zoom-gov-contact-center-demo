{
  "name": "zoom-gov-contact-center-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "test": "node --import tsx --test test/*.test.ts scripts/deploy/test/*.test.ts",
    "test:deploy": "node --import tsx --test scripts/deploy/test/*.test.ts",
    "test:admin-access:db": "node --import tsx --test scripts/deploy/integration-test/*.test.ts",
    "test:zaad:integration": "node --import tsx --test test/integration/zaad-api-route-runtime.test.ts",
    "test:zaad:zoom-contract": "node --import tsx --test --test-concurrency=1 test/integration/zoom-contact-center-asset-contract.test.ts test/integration/zoom-contact-center-campaign-contract.test.ts",
    "test:zaad:zoom-contract:asset": "node --import tsx --test test/integration/zoom-contact-center-asset-contract.test.ts",
    "test:zaad:zoom-contract:campaign": "node --import tsx --test test/integration/zoom-contact-center-campaign-contract.test.ts",
    "eval:plan-skills": "node scripts/eval-plan-skills.mjs",
    "eval:git-shipping-skill": "node scripts/eval-git-commit-push-pr.mjs",
    "plans:cleanup": "node scripts/cleanup-plan-files.mjs",
    "plans:guard": "node scripts/verify-plan-artifacts.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack",
    "vercel-build": "prisma generate && next build --webpack",
    "start": "next start",
    "faq:generate-translations": "tsx scripts/generate-faq-translations.ts",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:studio:docker": "prisma studio --port 5555 --browser none",
    "db:check-seed-admin": "tsx prisma/check-seed-admin.ts",
    "db:seed-admin": "tsx prisma/seed-admin.ts",
    "db:reset-seed-admin-password": "tsx prisma/reset-seed-admin-password.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/mdx": "^2.0.14",
    "better-auth": "1.6.26",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.4.2",
    "hono": "4.13.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "prisma": "7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "unicode-case-folding": "1.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "3.1111.0",
    "@aws-sdk/credential-providers": "3.1111.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "confbox": "0.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
